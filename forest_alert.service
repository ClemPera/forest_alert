[Unit]
Description=Forest Alert — Meshtastic emergency notification service
After=network-online.target
Wants=network-online.target

# Restart if signal-cli daemon dies (it's a separate service)
# If you run signal-cli as a service too, add: After=signal-cli.service

[Service]
Type=simple
# ↓ Change to your username and install path
User=pi
Group=pi

WorkingDirectory=/home/pi/forest_alert
# .venv/ is created by `uv sync`.  Using the venv python directly avoids
# spawning uv on every service restart.
ExecStart=/home/pi/forest_alert/.venv/bin/python main.py /home/pi/forest_alert/config.toml
Restart=always
RestartSec=10

# Give it time to gracefully shut down
TimeoutStopSec=15

# Logging goes to journald (follow with: journalctl -u forest_alert -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forest_alert

# Hardening (optional but good practice)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target