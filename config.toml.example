# ──────────────────────────────────────────────────────────────────────────
# Forest Alert — config.toml
# Copy this file to config.toml and fill in the values.
# ──────────────────────────────────────────────────────────────────────────

[meshtastic]
# IP address of the Meshtastic node on your local network
host = "192.168.1.XXX"
# Meshtastic TCP port (4403 by default)
port = 4403
# Seconds before retrying the connection if it drops
reconnect_delay = 10


[trigger]
# Keywords that trigger an emergency alert (case-insensitive, whole-word match)
keywords = ["HELP", "URGENCE", "SOS", "MAYDAY"]

# ID of your source node — find it in the Meshtastic app (e.g. "!abcdef01")
my_node_id = "!XXXXXXXX"

# If true, only react to messages coming from my_node_id
require_from_my_node = true


[dead_man]
enabled = true

# Keyword to send regularly to signal that you are OK
# Must NOT be in [trigger].keywords!
# Pick something distinctive that won't appear in casual messages.
heartbeat_keyword = "CHECKIN"

# Expected heartbeat frequency (hours)
heartbeat_interval_hours = 4.0

# Tolerance margin before alerting (hours)
grace_period_hours = 1.0

# Internal check frequency (minutes)
check_interval_minutes = 15.0


[signal]
# URL of the signal-cli daemon in HTTP JSON-RPC mode
# Start it with:
#   signal-cli -a +33XXXXXXXXX daemon --http=127.0.0.1:8080
rpc_url = "http://127.0.0.1:8080/api/v1/rpc"

# Signal phone numbers to alert (include country code)
contacts = ["+33XXXXXXXXX"]


[email]
# Backup email (optional but recommended)
enabled = false
smtp_host = "smtp.gmail.com"
smtp_port = 587
sender = "your@gmail.com"
# For Gmail: use an App Password
# https://myaccount.google.com/apppasswords
password = "xxxx xxxx xxxx xxxx"
recipients = ["contact@example.com"]


[cooldown]
# Minimum seconds between two alert bursts (prevents spam on repeated messages)
seconds = 300